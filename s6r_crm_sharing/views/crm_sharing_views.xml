<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_kanban_sharing" model="ir.ui.view">
        <field name="name">crm.lead.kanban.sharing</field>
        <field name="model">crm.lead</field>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" js_class="crm_sharing_kanban" on_create="quick_create" quick_create_view="s6r_crm_sharing.crm_lead_view_kanban_quick_create" records_draggable="0" groups_draggable="0">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="stage_id"/>
                <field name="expected_revenue"/>
                <t t-name="card">
                    <div class="row">
                        <div class="col-12">
                            <strong><field name="name"/></strong>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-8">
                            <field name="partner_id"/>
                        </div>
                        <div class="col-4 text-end">
                            <field name="expected_revenue" widget="monetary"/>
                        </div>
                    </div>
                </t>
            </kanban>
        </field>
    </record>

    <record id="crm_lead_view_tree_sharing" model="ir.ui.view">
        <field name="name">crm.lead.tree.sharing</field>
        <field name="model">crm.lead</field>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <list js_class="crm_sharing_list">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="contact_name"/>
                <field name="email_from"/>
                <field name="phone"/>
                <field name="stage_id"/>
            </list>
        </field>
    </record>

    <record id="crm_lead_view_kanban_quick_create" model="ir.ui.view">
        <field name="name">crm.lead.form.quick_create</field>
        <field name="model">crm.lead</field>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="company_id" invisible="1"/>
                    <field name="user_company_ids" invisible="1"/>
                    <field name="name" string="Opportunity Title" placeholder="e.g. Product Launch"/>
                    <field name="partner_id" placeholder="Customer"/>
                    <field name="expected_revenue" widget="monetary"/>
                </group>
            </form>
        </field>
    </record>

    <record id="crm_lead_view_form_sharing" model="ir.ui.view">
        <field name="name">crm.lead.form.sharing</field>
        <field name="model">crm.lead</field>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <form js_class="crm_sharing_form">
                <header>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '0'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Opportunity Title"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" invisible="1"/>
                            <field name="user_company_ids" invisible="1"/>
                            <field name="team_id" invisible="1"/>
                            <field name="partner_id"/>
                            <field name="email_from"/>
                            <field name="phone"/>
                        </group>
                        <group>
                            <field name="user_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="crm_lead_action_sharing" model="ir.actions.act_window">
        <field name="name">Opportunities</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('crm_lead_view_kanban_sharing')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('crm_lead_view_tree_sharing')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('crm_lead_view_form_sharing')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No opportunities found.
            </p>
        </field>
    </record>
</odoo>
