<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_kanban_sharing" model="ir.ui.view">
        <field name="name">crm.lead.kanban.sharing</field>
        <field name="model">crm.lead</field>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" create="false" js_class="crm_sharing_kanban">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="stage_id"/>
                <field name="expected_revenue"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="row">
                                <div class="col-12">
                                    <strong><field name="name"/></strong>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-8">
                                    <field name="partner_id"/>
                                </div>
                                <div class="col-4 text-end">
                                    <field name="expected_revenue" widget="monetary"/>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-12">
                                    <field name="stage_id" invisible="1"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="crm_lead_view_tree_sharing" model="ir.ui.view">
        <field name="name">crm.lead.tree.sharing</field>
        <field name="model">crm.lead</field>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <tree create="false" js_class="crm_sharing_list">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="contact_name"/>
                <field name="email_from"/>
                <field name="phone"/>
                <field name="stage_id"/>
            </tree>
        </field>
    </record>

    <record id="crm_lead_view_form_sharing" model="ir.ui.view">
        <field name="name">crm.lead.form.sharing</field>
        <field name="model">crm.lead</field>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <form js_class="crm_sharing_form">
                <header>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Opportunity Title"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" invisible="1"/>
                            <field name="user_company_ids" invisible="1"/>
                            <field name="partner_id"/>
                            <field name="email_from"/>
                            <field name="phone"/>
                        </group>
                        <group>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="team_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                </div>
            </form>
        </field>
    </record>

    <record id="crm_lead_action_sharing" model="ir.actions.act_window">
        <field name="name">Opportunities</field>
        <field name="res_model">crm.lead</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('type', '=', 'opportunity')]</field>
        <field name="context">{'default_type': 'opportunity'}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('crm_lead_view_kanban_sharing')}),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('crm_lead_view_tree_sharing')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('crm_lead_view_form_sharing')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No opportunities found.
            </p>
        </field>
    </record>
</odoo>
